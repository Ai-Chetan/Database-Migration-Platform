APP_NAME=Migration Platform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=migration_metadata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Aarya@16

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=TxSdK9RR0wnLx9aQ7CnXV5Jw2fPBwnyuBDfTRD-kSVtvEfzqjZpuG6b0XdwyzN5_oZNcGb5CUN5l6V4qxThcXA
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# ── Secret/password encryption (Connection Manager, Data Masking) ───────────
# CHANGE: this key previously only existed in backend/enterprise/.env, a
# file the running process never actually loads (see settings.py /
# main.py for the full explanation). It now lives here, in the one .env
# file that IS loaded, and every backend entrypoint calls load_dotenv()
# before importing anything that reads it.
# Keep this value stable across restarts/deployments - if it changes,
# every already-stored connection password becomes undecryptable and
# every saved connection will need to be re-entered.
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MIGRATION_ENCRYPTION_KEY=A2BOOQXX4Q6-kdzJPMxQtRSclP0mfTrm43lI2smMuzQ=

# ── Outbound email (forgot-password, welcome, password-changed notices) ─────
# All optional. If SMTP_HOST/USER/PASSWORD are left blank, emails are
# logged to the console instead of sent - useful for local development,
# but forgot-password / new-user emails will NOT actually be delivered
# until these are filled in for a real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=no-reply@migrationplatform.local
SMTP_USE_TLS=true

# Base URL of the deployed FRONTEND (not the API) - used to build links in
# emails, e.g. {APP_BASE_URL}/reset-password?token=...
APP_BASE_URL=http://localhost:5173
