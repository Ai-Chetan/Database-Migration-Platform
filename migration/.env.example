APP_NAME=Migration Platform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=migration_metadata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: keep this stable once you have real connections saved - if it
# changes, every stored connection password becomes undecryptable.
MIGRATION_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Outbound email - leave blank to log emails to console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=no-reply@migrationplatform.local
SMTP_USE_TLS=true

# The deployed FRONTEND url (not the API) - used for links inside emails.
APP_BASE_URL=http://localhost:5173

# Rate limiting on /auth/login and /auth/forgot-password (see
# backend/shared/middleware/rate_limit.py)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60

# --- added in S02 -------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (never '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true = the API refuses to start if any router module fails to import (use in tests/CI)
STRICT_ROUTERS=false
# true = log every SQL statement (very noisy; includes token hashes). Default false.
SQL_ECHO=false
# SQLAlchemy connection pool per process
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Worker settings (set per worker process): WORKER_ID defaults to a random id; QUEUE_TIMEOUT seconds
# WORKER_ID=worker-1
# QUEUE_TIMEOUT=5
